{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "functions": {
    "apps/backend/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/apps/backend/index.ts"
    }
  ]
}